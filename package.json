{
  "name": "wikimapia-semantic-search",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "vitest run --no-color",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "db:up": "docker compose up -d --build --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --build --wait",
    "test:db": "vitest run --no-color contracts/storage.test.ts contracts/hydration.test.ts tests/db tests/crawl",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:status": "tsx scripts/db-status.ts",
    "crawl": "tsx scripts/crawl.ts"
  },
  "dependencies": {
    "knex": "^3.3.0",
    "objection": "^3.9.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  }
}
